# Network: keep all infrastructure ports loopback-only by default.
INFRA_BIND_ADDRESS=127.0.0.1

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=hardware_ai_support
POSTGRES_USER=hardware_ai_app
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# MinIO object storage
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=hardware-ai-minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET_ASSETS=support-assets
MINIO_BUCKET_BACKUPS=support-backups

# Qdrant vector search
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=CHANGE_ME_QDRANT_API_KEY

# Local OCR. CPU is the default; use gpu only after the GPU image/profile is configured.
OCR_PORT=18081
OCR_LANGUAGE=en
OCR_DEVICE=cpu

# Local embedding and reranking. Model artifacts download only on the first start,
# then persist in the embedding_models Docker volume.
EMBEDDING_PORT=18082
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_DEVICE=cpu

# Application bootstrap secrets (all must be replaced before production use)
JWT_SECRET=CHANGE_ME_USE_A_32_BYTE_SECRET_AT_MINIMUM
QR_TOKEN_SECRET=CHANGE_ME_QR_SECRET_AT_LEAST_32_BYTES
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_BEFORE_USE
